{
  "expo": {
    "name": "RespiCare-Mobile",
    "slug": "RespiCare-Mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "respicaremobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.respicare.mobile",
      "infoPlist": {
        "NSHealthShareUsageDescription": "RespiCare necesita acceder a tus datos de salud para monitorear tu ritmo cardíaco, oxigenación y actividad física relacionada con enfermedades respiratorias.",
        "NSHealthUpdateUsageDescription": "RespiCare necesita escribir datos de salud para mantener un registro de tus métricas de salud respiratoria.",
        "NSMotionUsageDescription": "RespiCare necesita acceder a datos de movimiento para monitorear tu actividad física.",
        "NSLocationWhenInUseUsageDescription": "RespiCare necesita tu ubicación para proporcionar recomendaciones médicas basadas en tu ubicación."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.respicare.mobile",
      "versionCode": 1,
      "permissions": [
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-dev-client",
        {
          "android": {
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "minSdkVersion": 24
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "cd65e242-c8be-4bab-a7f1-c6c0d08a0ffe"
      }
    }
  }
}
